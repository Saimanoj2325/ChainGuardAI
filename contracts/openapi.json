          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Content Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        }
      }
    },
    "/api/v1/analyses/{job_id}/findings": {
      "get": {
        "summary": "Findings",
        "operationId": "findings_api_v1_analyses__job_id__findings_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "severity",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Severity"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Severity"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FindingsResponse"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Content Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        }
      }
    },
    "/api/v1/analyses/{job_id}/report": {
      "get": {
        "summary": "JSON report; ?format=markdown returns text/markdown",
        "operationId": "report_api_v1_analyses__job_id__report_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "json",
              "title": "Format"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditReport"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Content Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        }
      }
    },
    "/api/v1/reports/verify": {
      "post": {
        "summary": "Verify",
        "operationId": "verify_api_v1_reports_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuditReport": {
        "properties": {
          "report_id": {
            "type": "string",
            "title": "Report Id"
          },
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "schema_version": {
            "type": "string",
            "title": "Schema Version",
            "default": "1.0.0"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          },
          "contract": {
            "$ref": "#/components/schemas/ContractInfo"
          },
          "analyzers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Analyzers"
          },
          "summary": {
            "$ref": "#/components/schemas/SeverityCounts"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array",
            "title": "Findings"
          },
          "contains_mock_data": {
            "type": "boolean",
            "title": "Contains Mock Data",
            "default": false
          },
          "report_hash": {
            "type": "string",
            "title": "Report Hash"
          },
          "registry": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RegistryEntry"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "report_id",
          "job_id",
          "generated_at",
          "contract",
          "analyzers",
          "summary",
          "findings",
          "report_hash"
        ],
        "title": "AuditReport"
      },
      "Body_submit_api_v1_analyses_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_submit_api_v1_analyses_post"
      },
      "ContractInfo": {
        "properties": {
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "solc_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Solc Version"
          },
          "contracts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Contracts",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "filename",
          "sha256",
          "size_bytes"
        ],
        "title": "ContractInfo"
      },
      "DetectorSource": {
        "type": "string",
        "enum": [
          "slither",
          "heuristic",
          "gnn",
          "baseline_ml",
          "llm",
          "mock"
        ],
        "title": "DetectorSource"
      },
      "EVMVerdict": {
        "type": "string",
        "enum": [
          "not_run",
          "confirmed",
          "not_reproduced",
          "not_applicable",
          "error"
        ],
        "title": "EVMVerdict"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "Evidence": {
        "properties": {
          "lines": {
            "items": {
              "$ref": "#/components/schemas/LineRange"
            },
            "type": "array",
            "title": "Lines",
            "default": []
          },
          "snippet": {
            "type": "string",
            "title": "Snippet",
            "default": ""
          },
          "graph_nodes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Graph Nodes",
            "default": []
          },
          "dependency_path": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Dependency Path",
            "default": []
          },
          "tool_output": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Output"
          }
        },
        "type": "object",
        "title": "Evidence"
      },
      "Finding": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "vuln_class": {
            "$ref": "#/components/schemas/VulnClass"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "detectors": {
            "items": {
              "$ref": "#/components/schemas/DetectorSource"
            },
            "type": "array",
            "title": "Detectors"
          },
          "contract_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contract Name"
          },
          "function_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Function Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "recommendation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recommendation"
          },
          "evidence": {
            "$ref": "#/components/schemas/Evidence",
            "default": {
              "lines": [],
              "snippet": "",
              "graph_nodes": [],
              "dependency_path": []
            }
          },
          "verification": {
            "$ref": "#/components/schemas/Verification",
            "default": {
              "llm_status": "not_run",
              "evm_status": "not_run"
            }
          },
          "is_mock": {
            "type": "boolean",
            "title": "Is Mock",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "id",
          "vuln_class",
          "title",
          "severity",
          "confidence",
          "detectors",
          "description"
        ],
        "title": "Finding"
      },
      "FindingsResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array",
            "title": "Findings"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "findings"
        ],
        "title": "FindingsResponse"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "contract_version": {
            "type": "string",
            "title": "Contract Version",
            "default": "1.0.0"
          },
          "analyzers": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Analyzers"
          }
        },
        "type": "object",
        "required": [
          "status",
          "analyzers"
        ],
        "title": "Health"
      },
      "Job": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "stage": {
            "$ref": "#/components/schemas/JobStage"
          },
          "progress": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Progress"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "contract": {
            "$ref": "#/components/schemas/ContractInfo"
          },
          "analyzers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Analyzers",
            "default": []
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/StageEvent"
            },
            "type": "array",
            "title": "Events",
            "default": []
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "finding_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finding Count"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "stage",
          "progress",
          "created_at",
          "updated_at",
          "contract"
        ],
        "title": "Job"
      },
      "JobStage": {
        "type": "string",
        "enum": [
          "received",
          "parsing",
          "static_analysis",
          "ml_inference",
          "evidence",
          "llm_verification",
          "evm_validation",
          "reporting",
          "done"
        ],
        "title": "JobStage"
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "completed",
          "failed"
        ],
        "title": "JobStatus"
      },
      "LLMVerdict": {
        "type": "string",
        "enum": [
          "not_run",
          "supported",
          "refuted",
          "uncertain",
          "error"
        ],
        "title": "LLMVerdict"
      },
      "LineRange": {
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Start"
          },
          "end": {
            "type": "integer",
            "minimum": 1.0,
            "title": "End"
          }
        },
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "title": "LineRange"
      },
      "RegistryEntry": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "report_hash": {
            "type": "string",
            "title": "Report Hash"
          },
          "prev_entry_hash": {
            "type": "string",
            "title": "Prev Entry Hash"
          },
          "entry_hash": {
            "type": "string",
            "title": "Entry Hash"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "index",
          "report_hash",
          "prev_entry_hash",
          "entry_hash",
          "timestamp"
        ],
        "title": "RegistryEntry",
        "description": "Entry in the append-only hash-chained audit registry (local ledger; not a public blockchain)."
      },
      "Severity": {
        "type": "string",
        "enum": [
          "critical",
          "high",
          "medium",
          "low",
          "info"
        ],
        "title": "Severity"
      },
      "SeverityCounts": {
        "properties": {
          "critical": {
            "type": "integer",
            "title": "Critical",
            "default": 0
          },
          "high": {
            "type": "integer",
            "title": "High",
            "default": 0
          },
          "medium": {
            "type": "integer",
            "title": "Medium",
            "default": 0
          },
          "low": {
            "type": "integer",
            "title": "Low",
            "default": 0
          },
          "info": {
            "type": "integer",
            "title": "Info",
            "default": 0
          }
        },
        "type": "object",
        "title": "SeverityCounts"
      },
      "StageEvent": {
        "properties": {
          "stage": {
            "$ref": "#/components/schemas/JobStage"
          },
          "status": {
            "type": "string",
            "enum": [
              "started",
              "completed",
              "skipped",
              "failed"
            ],
            "title": "Status"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "title": "At"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "stage",
          "status",
          "at"
        ],
        "title": "StageEvent"
      },
      "SubmitResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "contract": {
            "$ref": "#/components/schemas/ContractInfo"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "contract"
        ],
        "title": "SubmitResponse"
      },
      "Verification": {
        "properties": {
          "llm_status": {
            "$ref": "#/components/schemas/LLMVerdict",
            "default": "not_run"
          },
          "llm_explanation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Llm Explanation"
          },
          "evm_status": {
            "$ref": "#/components/schemas/EVMVerdict",
            "default": "not_run"
          },
          "evm_details": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evm Details"
          }
        },
        "type": "object",
        "title": "Verification"
      },
      "VerifyRequest": {
        "properties": {
          "report": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Report"
